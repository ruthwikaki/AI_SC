# .env.example

# Application Settings
APP_NAME="Supply Chain Analytics"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
SECRET_KEY="your-secret-key-here-change-in-production"
API_V1_STR="/api/v1"
PROJECT_NAME="SSA Platform"

# Server Settings
HOST="0.0.0.0"
PORT=8000
WORKERS=4
RELOAD=true  # Set to false in production

# Database Configuration
DATABASE_URL="postgresql://ssa_user:ssa_password@localhost:5432/ssa_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_ECHO=false  # Set to true for SQL query logging

# Redis Configuration (for caching and sessions)
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""
REDIS_SSL=false
REDIS_POOL_SIZE=10

# Security
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","DELETE","OPTIONS"]'
CORS_ALLOW_HEADERS='["*"]'

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM_EMAIL="noreply@ssa-platform.com"
SMTP_FROM_NAME="SSA Platform"
SMTP_TLS=true
SMTP_SSL=false
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEMPLATES_DIR="app/templates/email"

# LLM Configuration
LLM_PROVIDER="openai"  # openai, anthropic, azure
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# Alternative LLM Providers
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-3-opus-20240229"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-instance.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4"

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS='[".csv",".xlsx",".xls",".json",".xml"]'

# AWS Configuration (optional)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="ssa-platform-uploads"
S3_BACKUP_BUCKET="ssa-platform-backups"

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="logs/app.log"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_ROTATION="midnight"
LOG_RETENTION_DAYS=30

# Background Jobs
SCHEDULER_ENABLED=true
SCHEDULER_API_ENABLED=true
SCHEDULER_TIMEZONE="UTC"
JOB_STORES_TYPE="sqlalchemy"
JOB_COALESCE=true
JOB_MAX_INSTANCES=3
JOB_MISFIRE_GRACE_TIME=300

# Analytics Settings
ANALYTICS_RETENTION_DAYS=90
QUERY_CACHE_TTL=3600  # 1 hour in seconds
METRICS_CALCULATION_INTERVAL=3600  # 1 hour
ABC_ANALYSIS_INTERVAL=86400  # 24 hours

# Performance Settings
QUERY_TIMEOUT=30
SLOW_QUERY_THRESHOLD=1.0  # seconds
ENABLE_QUERY_CACHE=true
CACHE_TTL=3600
MAX_QUERY_RESULTS=10000

# Data Sync Settings
SYNC_ENABLED=true
SYNC_INTERVAL=1800  # 30 minutes
SYNC_BATCH_SIZE=1000
SYNC_ERROR_THRESHOLD=10

# Feature Flags
ENABLE_MULTI_TENANCY=false
ENABLE_AUDIT_LOG=true
ENABLE_DATA_EXPORT=true
ENABLE_API_DOCS=true
ENABLE_METRICS_ENDPOINT=true

# External APIs
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
CURRENCY_API_KEY="your-currency-api-key"
WEATHER_API_KEY="your-weather-api-key"

# Monitoring (optional)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Development Settings
TESTING=false
GENERATE_SAMPLE_DATA=false
SEED_DATABASE=false
DROP_TABLES_ON_START=false

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=7
CLEANUP_OLD_BACKUPS=true

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT="100 per hour"
RATELIMIT_STORAGE_URL="redis://localhost:6379/1"

# Session Configuration
SESSION_COOKIE_NAME="ssa_session"
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax"
PERMANENT_SESSION_LIFETIME=86400  # 24 hours

# Timezone
TIMEZONE="UTC"