  "teaching_examples": [
    {
      "question": "show me all table names in the database",
      "sql": "SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' ORDER BY table_name;",
      "explanation": "Use information_schema.tables with table_name column (NOT tablename)"
    },
    {
      "question": "show supplier ratings",
      "sql": "SELECT name, rating FROM suppliers ORDER BY rating DESC;",
      "explanation": "Suppliers have 'rating' column directly"
    },
    {
      "question": "count products per supplier",
      "sql": "SELECT s.name, s.rating, COUNT(DISTINCT o.product_id) as product_count\n                     FROM suppliers s\n                     LEFT JOIN orders o ON s.id = o.supplier_id\n                     GROUP BY s.id, s.name, s.rating\n                     ORDER BY product_count DESC;",
      "explanation": "Products connect to suppliers through orders table"
    },
    {
      "question": "show products with low inventory",
      "sql": "SELECT p.id, p.name, p.sku, i.quantity_on_hand, i.reorder_point\n                         FROM products p\n                         JOIN inventory i ON i.product_id = p.id\n                         WHERE i.quantity_on_hand < i.reorder_point\n                         ORDER BY i.quantity_on_hand ASC;",
      "explanation": "Join products and inventory using i.product_id = p.id"
    }
  ]
}