# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/Supplychain_AI

# Security Keys (Generate new ones for production!)
JWT_SECRET_KEY=generate-a-secure-random-key-here
SECRET_KEY=generate-another-secure-key-here
ENCRYPTION_KEY=generate-encryption-key-here

# Environment
ENVIRONMENT=development

# Admin Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SecurePasswordHere!

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
DEFAULT_MODEL=ollama

# Optional: External LLM API
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
