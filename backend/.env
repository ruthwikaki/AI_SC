# backend/.env
# Environment Configuration for Supply Chain LLM

# General Settings
APP_NAME="Supply Chain LLM API"
API_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
HOST="0.0.0.0"
PORT=8000
UVICORN_WORKERS=1
BACKEND_PORT=8000
FRONTEND_PORT=3000
ML_PORT=8001

# Database Settings - Updated for docker-compose
DB_USER=postgres
DB_PASSWORD=123456789
DB_NAME=supplychain_AI
DB_PORT=5432
DATABASE_URL="postgresql://postgres:123456789@db:5432/supplychain_AI"  # 'db' is the docker service name

# Redis Settings - Required by docker-compose
REDIS_PASSWORD=ssa_redis_password
REDIS_PORT=6379
REDIS_URL="redis://:ssa_redis_password@redis:6379/0"  # 'redis' is the docker service name

# Security Settings - IMPORTANT: Change these!
SECRET_KEY="your-secret-key-change-in-production"
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Settings - Updated for local models
LLM_PROVIDER="local"  # Using local models instead of API
OPENAI_API_KEY=""     # Not needed for local models
ANTHROPIC_API_KEY=""  # Not needed for local models
DEFAULT_MODEL="llama3"  # or "mistral" - choose your default

# ML Service Settings
ML_SERVICE_URL="http://ml-service:8001"
ML_MEMORY_LIMIT="4G"
ML_MEMORY_RESERVATION="2G"
GPU_COUNT=0  # Set to 1 if you have NVIDIA GPU

# API Settings
API_V1_STR="/api/v1"

# Logging Settings
LOG_LEVEL="INFO"
LOG_TO_FILE=false
ENABLE_AUDIT_LOG=true
ENABLE_API_DOCS=true

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Settings
NODE_ENV="development"
VITE_API_URL="http://localhost:8000"
VITE_APP_NAME="Supply Chain Analytics"
VITE_APP_VERSION="1.0.0"

# Nginx Settings (Optional)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Monitoring Settings (Optional - for monitoring profile)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Backup Settings (Optional - for production profile)
S3_BACKUP_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=7