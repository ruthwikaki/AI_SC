# Database
DATABASE_URL=sqlite:///./supply_chain.db

# JWT Settings
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings - Allow all common frontend ports
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:5173"]

# Environment
ENVIRONMENT=development

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Supply Chain AI

# Security
SECRET_KEY=your-secret-key-here

# Rate Limiting - Disable for development
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

# Model paths (optional)
MODEL_PATH=./ml/models
