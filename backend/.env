# backend/.env
# Environment Configuration for Supply Chain LLM

# General Settings
APP_NAME="Supply Chain LLM API"
API_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
HOST="0.0.0.0"
PORT=8000
UVICORN_WORKERS=1

# Database Settings (for when you set up the database)
DATABASE_URL="postgresql://postgres:123456789@localhost:5432/supplychain_AI"

# Customer database (supply chain data)
CUSTOMER_DATABASE_URL="postgresql://postgres:123456789@localhost:5432/AI_SC"

# JWT Settings (you can change these later)
JWT_SECRET_KEY="your-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Settings (for when you integrate LLM)
# LLM_API_KEY="your-llm-api-key"
# LLM_API_BASE="https://api.your-llm-provider.com"
DEFAULT_MODEL="mistral-medium"

# Logging Settings
LOG_LEVEL="INFO"
LOG_TO_FILE=false

# CORS Settings
CORS_ORIGINS=["http://localhost:3001", "http://127.0.0.1:3001"]