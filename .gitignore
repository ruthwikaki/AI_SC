# ─── PYTHON: ignore compiled bytecode / cache folders ────────────────────────
__pycache__/
*.py[cod]
# (also ignore virtual environment dirs if you use them)
venv/
.env/
# ─── NPM: ignore node_modules ───────────────────────────────────────────────
node_modules/
# (optionally ignore lock files or build artifacts as needed)
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# ─── OS / Editor extras (optional) ──────────────────────────────────────────
.DS_Store
.vscode/

