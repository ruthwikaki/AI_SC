# Supply Chain LLM Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_ML_SERVICE_URL=http://localhost:8001

# Environment
VITE_ENVIRONMENT=development
VITE_APP_NAME=Supply Chain AI Assistant
VITE_APP_VERSION=1.0.0

# Map Configuration (US Center as default)
VITE_MAP_DEFAULT_LAT=39.8283
VITE_MAP_DEFAULT_LNG=-98.5795
VITE_MAP_DEFAULT_ZOOM=4
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Feature Flags
VITE_ENABLE_MULTI_TIER=true
VITE_ENABLE_NLQ=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_ADVANCED_ANALYTICS=true
VITE_ENABLE_PREDICTIVE_ANALYTICS=true
VITE_ENABLE_SCENARIO_PLANNING=true
VITE_ENABLE_CARBON_TRACKING=false
VITE_ENABLE_AI_INSIGHTS=true

# Authentication (if needed)
VITE_AUTH_ENABLED=false
VITE_AUTH_PROVIDER=local

# Analytics & Monitoring
VITE_ENABLE_ANALYTICS=false
VITE_GA_TRACKING_ID=
VITE_HOTJAR_ID=
VITE_SENTRY_DSN=

# Data Refresh Intervals (in milliseconds)
VITE_DASHBOARD_REFRESH_INTERVAL=30000
VITE_INVENTORY_REFRESH_INTERVAL=60000
VITE_REALTIME_UPDATE_INTERVAL=5000

# API Timeouts (in milliseconds)
VITE_API_TIMEOUT=30000
VITE_FILE_UPLOAD_TIMEOUT=120000

# File Upload Limits
VITE_MAX_FILE_SIZE_MB=50
VITE_ALLOWED_FILE_TYPES=.csv,.xlsx,.xls,.json

# Chart Configuration
VITE_CHART_ANIMATION_DURATION=750
VITE_CHART_COLOR_SCHEME=default

# Notification Settings
VITE_ENABLE_NOTIFICATIONS=true
VITE_NOTIFICATION_DURATION=5000

# Debug Mode
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# External Services (if applicable)
VITE_WEATHER_API_KEY=
VITE_GEOCODING_API_KEY=
VITE_ROUTING_API_KEY=

# Performance Optimization
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_LAZY_LOADING=true
VITE_CHUNK_SIZE_WARNING_LIMIT=500